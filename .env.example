# 复制为 .env 后填入自己的密钥
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_PROVIDER=deepseek
LLM_ALLOW_OVERRIDE=1

# ---- 公网鉴权（本地可留空；暴露到公网前必填）----
# 设置后所有 /api/* 必须带 Authorization: Bearer <token> 或 x-cortex-token
# 禁止只靠 x-cortex-user 冒充身份
# CORTEX_AUTH_TOKEN=change-me-long-random
# 多用户：令牌直接绑定用户（覆盖客户端伪造的 x-cortex-user）
# CORTEX_AUTH_TOKENS=alice:tok-a,bob:tok-b
# 共享令牌下强制的用户名（默认 local）；若要信任客户端头再开下一行
# CORTEX_AUTH_DEFAULT_USER=local
# CORTEX_AUTH_TRUST_USER_HEADER=1

# 记忆库位置与向量维度
CORTEX_DB=.cortex/memory.db
EMBED_DIM=512

# 记忆后端：sqlite（默认，分区 vec0）| pg（PGlite + pgvector，数据落 .cortex/pgdata）
CORTEX_MEMORY_BACKEND=sqlite
CORTEX_PG_DIR=.cortex/pgdata
# 接了真实 Postgres 时改成用 node-postgres：
# PG_URL=postgres://user:pass@host:5432/cortex

# 大仓监听：auto（默认，<=2000 文件用 fs.watch）| poll（网络盘/超大仓）
CORTEX_WATCH_MODE=auto
CORTEX_WATCH_INTERVAL=800
CORTEX_WATCH_DEPTH=8

# 百万级 ANN：超过 CORTEX_ANN_MIN 条的库才建二值量化索引；候选数 64~1024
CORTEX_ANN_MIN=20000
CORTEX_ANN_CAND=256
# 真正回 int8 侧表精排的条数（随机主键读，约 0.15ms/条；调小更快，调大更准）
CORTEX_ANN_RERANK=96
# 条数超过它才拉 worker 线程分担 Hamming 扫描（0 表示始终并行，很大表示从不并行）
CORTEX_ANN_PAR_MIN=200000
# 索引落盘（.cortex/ann/<库名>/u-<用户>-512d.v1.bin）：1 = 开（默认），0 = 每次启动重建
CORTEX_ANN_PERSIST=1
# ANN 引擎：bit（默认，二值量化）| hnsw（需 ≥16GB + npm i hnswlib-node；未接线时回退 bit）
# CORTEX_ANN_ENGINE=bit
# SQLite mmap 上限（MB）：int8 精排是随机主键读，靠页缓存吃饭
CORTEX_MMAP_MB=512

# 冷热分层：热点表容量上限 / 短路距离阈值（越小越保守，0 表示只在完全命中时短路）
CORTEX_HOT_MAX=2000
CORTEX_HOT_SKIP=0.11

# 沙箱执行：副本目录（默认 $TMPDIR/cortex-sandbox）与容器镜像 / docker 可执行文件
# CORTEX_SANDBOX_DIR=/tmp/cortex-sandbox
# CORTEX_SANDBOX_IMAGE=node:20-alpine
# CORTEX_DOCKER_BIN=docker
