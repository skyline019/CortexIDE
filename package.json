{
  "name": "cortex-ide",
  "private": true,
  "version": "0.6.4",
  "type": "module",
  "main": "desktop/main.mjs",
  "author": "Cortex",
  "description": "带持久记忆的 Agent IDE �?React 19 + Vite + CodeMirror 6",
  "scripts": {
    "dev": "node scripts/ensure-native-abi.mjs --target=node --quiet && vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "desktop": "electron .",
    "desktop:dev": "electron .",
    "icons:sync": "node scripts/sync-icons.mjs",
    "pdfjs:sync": "node scripts/sync-pdfjs-assets.mjs",
    "prebuild": "node scripts/sync-pdfjs-assets.mjs",
    "dist:win": "node scripts/ensure-native-abi.mjs --target=electron && npm run icons:sync && npm run pdfjs:sync && npm run build && electron-builder --win nsis portable --x64 && node scripts/ensure-native-abi.mjs --target=node --quiet",
    "dist:dir": "node scripts/ensure-native-abi.mjs --target=electron && npm run icons:sync && npm run pdfjs:sync && npm run build && electron-builder --win dir --x64 && node scripts/ensure-native-abi.mjs --target=node --quiet",
    "rebuild:native": "node scripts/ensure-native-abi.mjs --target=electron --force",
    "postinstall": "node scripts/desktop-postinstall.mjs",
    "smoke": "node scripts/smoke.mjs",
    "smoke:mock": "node scripts/smoke-mock.mjs",
    "bench": "node scripts/bench-memory.mjs",
    "bench:ann": "node scripts/bench-ann.mjs",
    "clean": "node scripts/clean.mjs",
    "pg:reset": "node scripts/pg-reset.mjs",
    "media": "node scripts/make-media.mjs",
    "db:compact": "node scripts/db-compact.mjs",
    "manifest": "node scripts/manifest.mjs",
    "bench:compress": "node scripts/bench-compress.mjs balanced",
    "bench:tokenizer": "node scripts/bench-tokenizer.mjs",
    "test": "node scripts/ensure-native-abi.mjs --target=node --quiet && node --test scripts/test-compress.test.mjs scripts/test-exec.test.mjs scripts/test-preview.test.mjs scripts/test-workflow.test.mjs scripts/test-refs.test.mjs scripts/test-media.test.mjs scripts/test-ann.test.mjs scripts/test-auth.test.mjs scripts/test-office.test.mjs scripts/test-pdf-text.test.mjs scripts/test-docx-mammoth.test.mjs scripts/test-chat-session.test.mjs scripts/test-ops.test.mjs scripts/test-memory-store.test.mjs scripts/test-agent-loop.test.mjs scripts/test-recall.test.mjs scripts/test-term-host.test.mjs",
    "test:all": "npm test && npm run bench:compress",
    "e2e": "bash scripts/e2e.sh",
    "e2e:report": "node scripts/e2e-report.mjs",
    "rebuild:node": "node scripts/ensure-native-abi.mjs --target=node --force",
    "predesktop": "node scripts/ensure-native-abi.mjs --target=electron",
    "smoke:key": "node scripts/smoke-key.mjs",
    "smoke:exe": "node scripts/smoke-exe.mjs"
  },
  "dependencies": {
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.15",
    "@electric-sql/pglite": "^0.5.11",
    "@electric-sql/pglite-pgvector": "^0.0.12",
    "@vitejs/plugin-react": "^6.1.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "better-sqlite3": "^12.11.1",
    "chokidar": "^5.0.0",
    "codemirror": "^6.0.2",
    "docx-preview": "^0.4.1",
    "mammoth": "^1.13.0",
    "node-pty": "npm:@lydell/node-pty@^1.2.0-beta.15",
    "pdfjs-dist": "^4.10.38",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sqlite-vec": "^0.1.9",
    "vite": "^8.3.4",
    "ws": "^8.22.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "electron": "^37.10.3",
    "electron-builder": "^26.0.12",
    "oxlint": "^1.88.0",
    "playwright": "^1.55.0"
  }
}
